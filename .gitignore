node_modules/
dist/
apps/admin/dist/
development/coverage/
# `apps/admin` writes its own coverage output here (vitest's default `coverage/` dir, ~1.5MB of
# `coverage-final.json` alone). Same rationale as `development/coverage/` above — build output, not
# source. Added after an audit run left it untracked-but-not-ignored, where a wide `git add` would
# have swept it into a commit.
apps/admin/coverage/
*.log
.DS_Store
.env
.env.*
# The template is the one .env file that MUST be tracked — it is how a fresh clone learns which
# variables a local boot needs. `development/scripts/dev.mjs` loads `.env` (never this file).
!.env.example
# infra/ is the site's runtime data folder: content.db + WAL sidecars, uploads/, the ADR-041 ops
# journals, plugin snapshots, restore points. None of it is source. README.md stays tracked so the
# directory exists in a fresh clone -- openContentDb does not create the parent, so an absent
# infra/ fails boot with SQLITE_CANTOPEN.
infra/*
!infra/README.md

# Vendored dev toolkit — cloned separately, has its own git history (not part of Tovu)
AI-Dev-Shop/

.playwright-mcp/

# Playwright VRT (AW-2) — local run artifacts only; baseline screenshots under
# development/e2e/**/*-snapshots/ ARE committed (checked baselines, not artifacts).
test-results/
# Playwright's per-config output dirs (`development/playwright.*.config.ts` each set their own
# `outputDir`), ~27MB of traces/screenshots across the two that exist today. Same class as
# `test-results/` above, which only matched the bare name.
development/test-results-*/
development/playwright-report/
blob-report/
# Regenerated-on-every-run screenshots (e.g. connectors-screenshot.spec.ts), not checked baselines
# — those live under `*-snapshots/` above and stay committed. Same "artifact, not fixture" split.
development/e2e/__screenshots__/
# Ad-hoc debug captures and one-off probe scripts written during interactive runs (~4.7MB today).
# Same "artifact, not fixture" split as the two entries above: nothing here is a checked baseline.
development/e2e/.artifacts/

# stray/local artifacts (do not track)
admin-page.png
# Playwright accessibility-tree dump from an interactive exploration pass; regenerate on demand.
explore-snapshot.md
# Stray SQLite journal written outside infra/ by a local run. Runtime data, not source.
ops/database-journal.db
:memory:.snapshot-newsletter-*
:memory:.snapshot-comments-*
:memory:.snapshot-store-*
.claude/settings.local.json
# ADS-memory: only the pipeline artifacts are committed. Everything else in the
# workspace (docs/, governance/, knowledge/, sessions/, meta/, .local-artifacts/,
# tmp/) is local-only. Excluding the direct children rather than `ADS-memory/**`
# is what lets git still descend into the three re-included directories.
ADS-memory/*
!ADS-memory/reports/
!ADS-memory/specs/
!ADS-memory/specs_as_built/
# Multi-megabyte generated dump; regenerate from the Shopify Admin API instead.
development/other-repos-specs/shopify_specs/schema-dumps/
.mcp.json
# Per-run MCP config the agent daemon writes for each spawned CLI (`mcp-injection.ts`), named
# `.mcp.jini-<runId>.json`. Transient and machine-specific; one is left behind per run.
.mcp.jini-*.json
