node_modules/
dist/
apps/admin/dist/
development/coverage/
*.log
.DS_Store
.env
.env.*
# infra/ is the site's runtime data folder: content.db + WAL sidecars, uploads/, the ADR-041 ops
# journals, plugin snapshots, restore points. None of it is source. README.md stays tracked so the
# directory exists in a fresh clone -- openContentDb does not create the parent, so an absent
# infra/ fails boot with SQLITE_CANTOPEN.
infra/*
!infra/README.md

# Vendored dev toolkit — cloned separately, has its own git history (not part of Tovu)
AI-Dev-Shop/

.playwright-mcp/

# Playwright VRT (AW-2) — local run artifacts only; baseline screenshots under
# development/e2e/**/*-snapshots/ ARE committed (checked baselines, not artifacts).
test-results/
development/playwright-report/
blob-report/

# stray/local artifacts (do not track)
admin-page.png
:memory:.snapshot-newsletter-*
:memory:.snapshot-comments-*
:memory:.snapshot-store-*
.claude/settings.local.json
# ADS-memory: only the pipeline artifacts are committed. Everything else in the
# workspace (docs/, governance/, knowledge/, sessions/, meta/, .local-artifacts/,
# tmp/) is local-only. Excluding the direct children rather than `ADS-memory/**`
# is what lets git still descend into the three re-included directories.
ADS-memory/*
!ADS-memory/reports/
!ADS-memory/specs/
!ADS-memory/specs_as_built/
# Multi-megabyte generated dump; regenerate from the Shopify Admin API instead.
development/other-repos-specs/shopify_specs/schema-dumps/
.mcp.json
# Per-run MCP config the agent daemon writes for each spawned CLI (`mcp-injection.ts`), named
# `.mcp.jini-<runId>.json`. Transient and machine-specific; one is left behind per run.
.mcp.jini-*.json
