{%- comment -%}
  Minima — entry (single post). Adapted from jekyll/minima's `_layouts/post.html`:
  a plain title, a meta line, then the post body. No prev/next (Tovu has no
  adjacency data for that yet).
{%- endcomment -%}
{% render_block component: "tovu/site-header", compact: true %}

<main class="page-content">
  <div class="wrapper">
    {%- if post -%}
      <article class="post">
        <header class="post-header">
          <h1 class="post-title">{{ post.title }}</h1>
          <p class="post-meta">{{ post.date | date: "%b %-d, %Y" }}</p>
        </header>
        <div class="post-content">{{ post.content | raw }}</div>
      </article>
      <a class="post-back" href="/">← Back to all posts</a>
    {%- endif -%}
  </div>
</main>

{% render_block component: "tovu/site-footer" %}
