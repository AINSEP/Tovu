# Local development environment. Copy to `.env`; npm start and npm run dev load it.
# Production deployments set real environment variables instead.

# --- Site key ---------------------------------------------------------------
# This key protects saved credentials and derives signing secrets. Local sites create their
# own key automatically outside the portable site directory; no Generate click is needed.
# To supply the key through the environment, use a hex value of at least 32 bytes.
# TOVU_SITE_KEY is the only environment name read for the site key.
# Back up the existing key privately. Without it, saved credentials cannot be recovered.
# `docker compose up` (docker-compose.yml) refuses to start while this is unset or empty.
TOVU_SITE_KEY=

# --- Optional ----------------------------------------------------------------

# Seeded admin credentials. Default to admin / tovu-dev when unset (identity/wiring.ts).
# Optional for local development only — under TOVU_RUNTIME_MODE=production the boot gate REFUSES
# to start while TOVU_ADMIN_PASSWORD is unset or still the default (PRODUCTION_BOOT_UNSAFE_DEFAULT).
# Seeded on first boot only, stored as an argon2id hash; changing it later does nothing to an
# existing install — use Users → Reset password in the admin.
# TOVU_ADMIN_USER=admin
# TOVU_ADMIN_PASSWORD=tovu-dev

# Ports. dev.mjs preflights each one and names the process holding it rather than failing obscurely.
# PORT=3000
# TOVU_ADMIN_DEV_PORT=5173
# JINI_AGENT_DAEMON_PORT=4319

# Which proxies to trust for the client IP in X-Forwarded-For (per-IP rate limits, stored form
# source IPs). Unset: none locally; on Fly (FLY_APP_NAME set) exactly one hop, Fly's edge. Set it
# when Tovu runs behind another reverse proxy: the number of proxy hops in front of it (e.g. 1),
# or a list of proxy addresses/subnets (e.g. "loopback, 10.0.0.0/8"). "false" or 0 trusts none.
# "true" is refused at boot: it would let any client spoof its IP.
# TOVU_TRUST_PROXY=1

# Legacy gap-discovery diagnostic: also disables local-owner native fallbacks and selects
# the strict prohibition prompt. Prefer TOVU_AGENT_NATIVE_FALLBACKS=0 to restore the normal lock.
# This is a tool-availability switch, not an OS filesystem security boundary.
# TOVU_AGENT_FORBID_BASH=1

# Tracing (OpenTelemetry). Off unless an OTLP endpoint is set; then Tovu exports spans for
# inbound requests, database queries, outbound HTTP calls and admin-chat agent runs over OTLP/HTTP.
# Standard OpenTelemetry names, so Datadog (Agent OTLP receiver) and Grafana (Alloy/Tempo/Cloud
# OTLP gateway) need no Tovu-specific setup. How-to: development/docs/deployment/observability.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318        # base URL; /v1/traces is appended
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=                      # full traces URL; wins over the base
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20xxxx    # collector auth (Grafana Cloud, etc.)
# OTEL_SERVICE_NAME=tovu

# --- Secrets and recovery ----------------------------------------------------

# Private seed for daily visitor analytics hashes; default: insecure development placeholder; use a stable non-empty secret.
# ANALYTICS_ROOT_KEY_SEED=change-me

# Salt for comment IP hashes; default: derived from the site key, or a development/per-process fallback without a key.
# COMMENTS_IP_SALT=change-me

# Password for owner recovery at boot or via reset-owner; default: no boot reset and the CLI prompts; unset after use.
# TOVU_ADMIN_RESET_PASSWORD=change-me

# Username to verify when resetting the owner password; default: the persisted owner account.
# TOVU_ADMIN_RESET_USERNAME=admin

# --- Hosting and access ------------------------------------------------------

# Server bind IP; default: 127.0.0.1 for tovu serve, all interfaces for the direct server; use an IP literal.
# TOVU_HOST=127.0.0.1

# Public site origin for links and callbacks; default: no override (local may seed localhost); registered origins require non-loopback HTTPS.
# TOVU_PUBLIC_URL=https://example.com

# Mark the assistant runtime as hosted; default: off unless other host signals apply; 1 or true enables hosted restrictions.
# TOVU_HOSTED=1

# Enable the local Sites switcher; default: off (the dev launcher enables it); 1 or true enables it outside production.
# TOVU_ENABLE_SITE_SWITCHER=1

# Maximum concurrently supervised local sites; default: 3; use an integer from 1 to 20.
# TOVU_LOCAL_SITE_LIMIT=3

# Agent CLI permission mode; default: bypass locally, restricted when hosted or in production; values: bypass or restricted.
# TOVU_AGENT_PERMISSION_MODE=restricted

# Minutes before an idle agent daemon parks; default: 15; use nonnegative finite minutes within the safe millisecond range, or 0 to disable.
# TOVU_AGENT_DAEMON_IDLE_MINUTES=15

# Name the trusted ingress plugin supplying visitor regions for consent; default: none, with strict consent if no trusted header is set.
# TOVU_CONSENT_INGRESS=cloudflare

# Trust an additional proxy header for consent regions; default: none, with strict consent if no ingress is set.
# TOVU_CONSENT_REGION_HEADER=CF-IPCountry

# --- Site storage ------------------------------------------------------------

# Home folder for new sites; default: saved Sites setting or the user's Documents/Tovu folder.
# TOVU_SITES_HOME=/path/to/sites

# Folder of the site this process serves; default: TOVU_SITE or tovu-dev in the sites home/catalog, falling back to <cwd>/sites/tovu-dev.
# TOVU_SITE_DIR=/path/to/site

# SQLite content database path; default: the site's configured placement; the file must be named content.db; ignored by tovu serve <dir>.
# TOVU_CONTENT_DB=/path/to/content.db

# SQLite chat database path; default: the site's configured chat.db, normally beside content.db; ignored by tovu serve <dir>.
# TOVU_CHAT_DB=/path/to/chat.db

# Select an ephemeral direct-server store with memory; default: configured site storage, usually SQLite; ignored by tovu serve <dir>.
# TOVU_DB=memory

# PGlite owner's socket for a database client; default: derived by the site-store client or supplied by the supervisor; required by standalone DB clients.
# TOVU_PG_SOCKET=/path/to/pglite.sock

# SQLite database incident journal path; default: <content-db directory>/ops/database-journal.db.
# TOVU_DATABASE_JOURNAL_DB=/path/to/database-journal.db

# Local media blob directory; default: <site>/uploads.
# TOVU_MEDIA_UPLOADS_DIR=/path/to/uploads

# Staged chat attachment directory; default: <site>/uploads/chat-attachments in the composed server.
# TOVU_CHAT_ATTACHMENTS_DIR=/path/to/chat-attachments

# Site-owned themes directory; default: <site>/themes.
# TOVU_THEMES_DIR=/path/to/themes

# Product-shipped theme seed directory; default: <product>/content/themes.
# TOVU_STOCK_THEMES_DIR=/path/to/stock-themes

# Product-shipped per-site content and uploads seed directory; default: <product>/content/seed-sites.
# TOVU_STOCK_CONTENT_SEED_DIR=/path/to/seed-sites

# Static site export output directory; default: <site>/out/export.
# TOVU_EXPORT_DIR=/path/to/export

# Static publish output parent directory; default: <site>/out/publish.
# TOVU_PUBLISH_DIR=/path/to/publish

# Source-control export scratch directory; default: <site>/out/source-control-export.
# TOVU_SOURCE_CONTROL_EXPORT_DIR=/path/to/source-control-export

# Media blob storage backend; default: site storage setting, then local; values: local or a bundled provider selector such as s3.
# TOVU_MEDIA_BLOB_STORE=local

# --- Plugins and skills ------------------------------------------------------

# Site-installed CMS plugins directory; default: <site>/plugins (in-memory mode scans none unless set).
# TOVU_PLUGINS_DIR=/path/to/plugins

# Installed agent plugins directory; default: <site>/agent-plugins; the override must be absolute.
# TOVU_AGENT_PLUGINS_DIR=/path/to/agent-plugins

# Installed standalone agent skills directory; default: <site>/skills; the override must be absolute.
# TOVU_SKILLS_DIR=/path/to/skills

# Allow local folder or ZIP plugin installs on hosted deployments; default: off when hosted, on locally; 1 opts in.
# TOVU_PLUGIN_LOCAL_INSTALL=1

# Tier-2 plugin worker timeout in milliseconds; default: 5000; use an integer from 1 to 60000.
# TOVU_PLUGIN_TIER2_TIMEOUT_MS=5000

# Theme render worker timeout in milliseconds; default: 5000; use an integer from 1 to 300000.
# TOVU_THEME_RENDER_TIMEOUT_MS=5000

# --- Visitor assistant and sharing -------------------------------------------

# Visitor assistant execution mode; default: byok; byok is the only supported mode.
# TOVU_SITE_ASSISTANT_MODE=byok

# Google visitor assistant endpoint fallback; default: saved endpoint or the provider's default; used only for Google.
# TOVU_SITE_ASSISTANT_BASE_URL=https://example.com

# Google visitor assistant model fallback; default: saved model or gemini-flash-latest for Google; used only for Google.
# TOVU_SITE_ASSISTANT_MODEL=gemini-flash-latest

# Disable the visitor tool policy and its publication with off; default: enabled subject to site settings.
# TOVU_VISITOR_TOOLS_POLICY=off

# Confirm shared artifacts have persistent storage for runtime delivery; default: off; 1 enables it with a public origin.
# TOVU_SHARE_PERSISTENT_STORAGE=1

# Public origin for runtime share delivery; default: unset, so runtime delivery is disabled.
# TOVU_SHARE_PUBLIC_ORIGIN=https://example.com

# --- Request logging and product telemetry -----------------------------------

# Log completed HTTP requests; default: off; 1 enables it.
# TOVU_LOG_REQUESTS=1

# Log completed requests slower than this many milliseconds; default: no slow-request logging.
# TOVU_LOG_SLOW_REQUESTS=1000

# Product telemetry provider configuration file; default: unset for the server, or the packaged desktop resource file.
# TOVU_PRODUCT_TELEMETRY_CONFIG=/path/to/product-telemetry.json

# Product telemetry consent preferences file; default: unset for the server, with desktop supplying its own path.
# TOVU_PRODUCT_TELEMETRY_PREFS=/path/to/telemetry-preferences.json

# Allow observability export in development; default: eligibility follows the launch type; 1 overrides it but does not grant consent.
# TOVU_TELEMETRY_FORCE_ENABLE=1

# --- Docker (docker-compose.yml) ---------------------------------------------
#
# `docker compose` reads `.env` from this directory too, by its own mechanism — unrelated to
# dev.mjs's loader above, and unaffected by the note at the top that `npm start` ignores `.env`.
# The same file therefore serves both a local `npm run dev` and a container run.

# THE SWITCH THAT ARMS EVERY PRODUCTION SAFETY CHECK, and the only signal consulted for it —
# NODE_ENV is never read for this purpose (src/core/runtime-mode.ts). Anything other than the
# literal "production" resolves to `local`, which activates NO containment: no boot gate, no
# default-password refusal, no capability containment. Leave it unset for local development.
# TOVU_RUNTIME_MODE=production

# Local owner chats may fall back to native Bash/file edits after trying Tovu tools.
# Every fallback is recorded in Observability > Tool gaps. Set 0 to disable again.
# Visitors/non-owners and production/hosted deployments never receive this grant.
# TOVU_AGENT_NATIVE_FALLBACKS=0

# Host port the container publishes on. The container always listens on 3000 internally.
# TOVU_PORT=3000

# BUILD-time, not runtime: installs headless Chromium into the image for browser-backed tools
# (site_collect_page_evidence, web_screenshot_page). Off by default (owner decision 2026-10-08) —
# it adds ~150MB+ to the image and ~150–250 MB of RAM per capture. Rebuild after changing it.
# TOVU_INSTALL_BROWSER=1
