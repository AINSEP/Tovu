{
  "$schema": "https://tovu.dev/schemas/theme/v2/theme.schema.json",
  "apiVersion": 2,
  "id": "basic",
  "name": "Basic",
  "version": "0.1.0",
  "tier": "static",
  "description": "A premium-themed-websites marketing + auth site (home, about, pricing, docs, blog, changelog, download, sign in, sign up). Plain HTML/CSS/JS, no build step, no template language — every byte is editable. Ships both a dark and a light token set.",
  "modes": [
    "dark",
    "light"
  ],
  "defaultMode": "dark",
  "fonts": [
    "Geist:wght@400;500",
    "Geist+Mono:wght@400;500"
  ],
  "pages": [
    "index",
    "about",
    "pricing",
    "docs",
    "blog",
    "changelog",
    "download",
    "signin",
    "signup"
  ],
  "templates": [
    "posts-default.html",
    "posts-sidebar.html",
    "pages-default.html"
  ],
  "slots": {
    "nav": {
      "source": "nav.html",
      "honorsCurrentPage": true
    },
    "footer": {
      "source": "footer.html",
      "variants": {
        "minimal": "footer-minimal.html"
      }
    }
  },
  "publishedPages": [
    "about",
    "blog",
    "pricing",
    "signin",
    "signup"
  ]
}
