{
 "testRunner": "tap",
 "tap": {
  "nodeArgs": [
   "--import",
   "tsx",
   "--experimental-test-module-mocks",
   "--test-reporter=tap"
  ],
  "testFiles": [
   "apps/website/src/server/inbound/admin-http/routes/system/__tests__/site-key-sources.unit.test.ts",
   "apps/website/src/server/inbound/admin-http/routes/system/__tests__/site-key-state.unit.test.ts",
   "apps/website/src/server/inbound/admin-http/routes/system/__tests__/site-key.tw4.pins.test.ts"
  ]
 },
 "mutate": [
  "apps/website/src/server/inbound/admin-http/routes/system/site-key.ts"
 ],
 "coverageAnalysis": "off",
 "concurrency": 3,
 "reporters": [
  "json",
  "clear-text",
  "progress-append-only"
 ],
 "jsonReporter": {
  "fileName": "/root/stryker/reports/site-key.json"
 },
 "mutator": {
  "excludedMutations": [
   "StringLiteral"
  ]
 },
 "tempDirName": ".stryker-tmp",
 "cleanTempDir": true,
 "disableTypeChecks": true,
 "incremental": false,
 "timeoutMS": 20000,
 "timeoutFactor": 2,
 "tap_env": {}
}