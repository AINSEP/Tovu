  "src/lib/agent-screenshot-bus.ts",
  "src/lib/agent-screenshot.ts",
  "src/lib/app-version.ts",
  "src/lib/assistant-agents-snapshot.ts",
  "src/lib/assistant-chats.ts",
  "src/lib/assistant-dock-bus.ts",
  "src/lib/assistant-prompt-bus.ts",
  "src/lib/assistant-subagents.ts",
  "src/lib/block-atom-insert.ts",
  "src/lib/chat-attachment-liveness.ts",
  "src/lib/content-refresh-bus.ts",
  "src/lib/credential-card-guidance.ts",
  "src/lib/credential-copy.ts",
