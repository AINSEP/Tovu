  "src/admin-themes/apply.ts",
  "src/admin-themes/registry.ts",
  "src/admin-themes/use-admin-theme.hooks.ts",
  "src/lib/a2ui-action-poster.ts",
  "src/lib/addons-routes.ts",
  "src/lib/admin-dev-origin.ts",
  "src/lib/agent-pages.ts",
