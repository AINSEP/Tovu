  "src/lib/widget-embed-extension.hooks.ts",
  "src/lib/widget-embed-placement-content.ts",
  "src/media-panel.ts",
  "src/nav.ts"
 ],
 "coverageAnalysis": "perTest",
 "concurrency": 4,
 "incremental": false,
 "mutator": {
  "excludedMutations": [
