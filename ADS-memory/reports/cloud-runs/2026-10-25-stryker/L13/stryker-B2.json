  "fileName": "/root/stryker/reports/B2.json"
 },
 "tempDirName": ".stryker-tmp",
 "cleanTempDir": false,
 "disableTypeChecks": true,
 "dryRunTimeoutMinutes": 40,
 "timeoutMS": 20000,
 "timeoutFactor": 2,
 "ignoreStatic": true
}