{
 "testRunner": "tap",
 "tap": {
  "nodeArgs": [
   "--import",
   "tsx",
   "--experimental-test-module-mocks",
   "--test-reporter=tap"
  ],
  "testFiles": [
   "apps/website/src/features/database-transfer/__tests__/confirmation-policy.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/confirmation-ui.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/destination-exchange.l240.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/destination-repo.dialects.test.ts",
   "apps/website/src/features/database-transfer/__tests__/destination-store.l240.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/destination-store.migrated.test.ts",
   "apps/website/src/features/database-transfer/__tests__/destination-store.sqlite.test.ts",
   "apps/website/src/features/database-transfer/__tests__/destination-ui.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/postgres-ddl.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/table-catalog.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/tool-registrations.faults.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/transfer-completeness.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/transfer-messages.unit.test.ts",
   "apps/website/src/features/database-transfer/__tests__/transfer-snapshots.unit.test.ts"
  ]
 },
 "mutate": [
  "apps/website/src/features/database-transfer/**/*.ts",
  "!apps/website/src/features/database-transfer/**/__tests__/**",
  "!apps/website/src/features/database-transfer/**/*.test.ts",
  "!apps/website/src/features/database-transfer/**/*.d.ts",
  "!apps/website/src/features/database-transfer/**/types.ts",
  "!apps/website/src/features/database-transfer/index.ts",
  "!apps/website/src/features/database-transfer/**/*-types.ts",
  "!apps/website/src/features/database-transfer/**/ports.ts"
 ],
 "coverageAnalysis": "perTest",
 "concurrency": 3,
 "reporters": [
  "json",
  "clear-text",
  "progress-append-only"
 ],
 "jsonReporter": {
  "fileName": "/root/stryker/reports/l7-database-transfer.json"
 },
 "mutator": {
  "excludedMutations": [
   "StringLiteral"
  ]
 },
 "tempDirName": ".stryker-tmp",
 "cleanTempDir": true,
 "disableTypeChecks": true,
 "incremental": false
}