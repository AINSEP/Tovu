{
  "schemaVersion": 1,
  "targets": [
    {
      "id": "netlify",
      "label": "Netlify",
      "module": "targets/netlify.mjs",
      "env": {
        "tokenVars": [
          "NETLIFY_TOKEN",
          "NETLIFY_ACCESS_TOKEN",
          "NETLIFY_AUTH_TOKEN"
        ]
      },
      "credential": {
        "vendorId": "netlify",
        "fields": [
          {
            "name": "token",
            "label": "Personal access token",
            "required": true,
            "secret": true,
            "help": "Netlify: User settings > Applications > Personal access tokens."
          },
          {
            "name": "siteId",
            "label": "Site ID",
            "help": "Optional. Netlify finds or creates the site from the project name."
          }
        ]
      }
    },
    {
      "id": "cloudflare-pages",
      "label": "Cloudflare Pages",
      "module": "targets/cloudflare-pages.mjs",
      "env": {
        "tokenVars": [
          "CLOUDFLARE_TOKEN",
          "CLOUDFLARE_API_TOKEN"
        ],
        "fields": {
          "accountId": "CLOUDFLARE_ACCOUNT_ID"
        }
      },
      "credential": {
        "vendorId": "cloudflare",
        "vendorLabel": "Cloudflare",
        "fields": [
          {
            "name": "token",
            "label": "API token",
            "required": true,
            "secret": true,
            "help": "Cloudflare: My Profile > API Tokens, with the Cloudflare Pages: Edit permission."
          },
          {
            "name": "accountId",
            "label": "Account ID",
            "required": true,
            "help": "Shown on the Cloudflare dashboard's account home page."
          },
          {
            "name": "projectName",
            "label": "Project name"
          }
        ]
      }
    },
    {
      "id": "vercel",
      "label": "Vercel",
      "module": "targets/vercel.mjs",
      "config": [
        {
          "name": "teamId",
          "label": "Team ID",
          "help": "Only for a team account. Leave blank for a personal account."
        }
      ],
      "env": {
        "tokenVars": [
          "VERCEL_TOKEN",
          "VERCEL_ACCESS_TOKEN"
        ]
      },
      "credential": {
        "vendorId": "vercel",
        "yieldsAccountLabel": true,
        "fields": [
          {
            "name": "token",
            "label": "Access token",
            "required": true,
            "secret": true,
            "help": "Vercel: Account settings > Tokens."
          },
          {
            "name": "teamId",
            "label": "Team ID",
            "help": "Only for a team account."
          }
        ]
      }
    },
    {
      "id": "github-pages",
      "label": "GitHub Pages",
      "module": "targets/github-pages.mjs",
      "config": [
        {
          "name": "owner",
          "label": "Owner",
          "required": true,
          "help": "The GitHub user or organization that owns the repository. Default it to the verified account (accountLabel) and confirm it; never guess it."
        },
        {
          "name": "repo",
          "label": "Repository",
          "required": true,
          "help": "The repository to publish to. The site is served from /<repository>."
        },
        {
          "name": "branch",
          "label": "Branch",
          "help": "Defaults to gh-pages."
        }
      ],
      "env": {
        "tokenVars": [
          "GITHUB_TOKEN",
          "GH_TOKEN",
          "GITHUB_ACCESS_TOKEN"
        ]
      },
      "credential": {
        "vendorId": "github",
        "vendorLabel": "GitHub",
        "yieldsAccountLabel": true,
        "fields": [
          {
            "name": "token",
            "label": "Personal access token",
            "required": true,
            "secret": true,
            "help": "GitHub: Settings > Developer settings > Personal access tokens, with write access to the repository's contents."
          }
        ]
      }
    },
    {
      "id": "s3-compatible",
      "label": "S3-compatible storage",
      "module": "targets/s3-compatible.mjs",
      "credential": {
        "vendorId": "s3-compatible",
        "vendorLabel": "the storage provider",
        "tokenField": "secretAccessKey",
        "fields": [
          {
            "name": "endpoint",
            "label": "Endpoint",
            "help": "Leave blank for AWS S3. Required for R2, B2, Spaces, Wasabi and MinIO."
          },
          {
            "name": "region",
            "label": "Region",
            "required": true
          },
          {
            "name": "bucket",
            "label": "Bucket",
            "required": true
          },
          {
            "name": "accessKeyId",
            "label": "Access key ID",
            "required": true
          },
          {
            "name": "secretAccessKey",
            "label": "Secret access key",
            "required": true,
            "secret": true
          },
          {
            "name": "publicUrl",
            "label": "Public URL",
            "required": true,
            "help": "The address the bucket's files are served from."
          }
        ]
      }
    }
  ]
}
