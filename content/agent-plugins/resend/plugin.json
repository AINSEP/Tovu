{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "resend",
  "version": "0.2.0",
  "description": "Sends the site's email (sign-in links, form notifications, newsletters) through Resend's hosted email API, and connects the assistant to Resend's own hosted MCP server for work on the Resend account itself: domains and their DNS verification, broadcasts, contacts, segments, topics, templates, logs and usage. Ships the mail adapter (Tovu loads it only because Tovu shipped it) and the know-how to set both up: a sending key saved through credential_save for site mail, and agent_plugin_connect (Resend sign-in, or a full-access key as the fallback) for the account tools.",
  "author": "Tovu",
  "license": "Apache-2.0",
  "extensions": {
    "tovu": {
      "summary": "Sends your site's emails through Resend, and lets the assistant manage your Resend account: domains, broadcasts and contacts.",
      "id": "tovu/resend",
      "provides": [
        "outbound-mail"
      ],
      "mcpServers": {
        "resend": {
          "tovuAuthMode": "oauth",
          "tovuDefaultTools": {
            "allow": [
              "list-domains",
              "get-domain",
              "get-domain-claim",
              "list-emails",
              "get-email",
              "get-email-metrics",
              "list-received-emails",
              "get-received-email",
              "list-received-email-attachments",
              "get-received-email-attachment",
              "list-broadcasts",
              "get-broadcast",
              "list-broadcast-recipients",
              "list-broadcast-clicked-links",
              "list-contacts",
              "get-contact",
              "list-contact-segments",
              "list-contact-topics",
              "list-segments",
              "get-segment",
              "list-topics",
              "get-topic",
              "list-contact-properties",
              "get-contact-property",
              "list-templates",
              "get-template",
              "list-webhooks",
              "get-webhook",
              "list-webhook-events",
              "get-webhook-event",
              "list-webhook-event-attempts",
              "list-api-keys",
              "list-logs",
              "get-log",
              "get-usage",
              "list-suppressions",
              "get-suppression",
              "create-domain",
              "update-domain",
              "verify-domain",
              "create-domain-claim",
              "verify-domain-claim",
              "send-email",
              "send-batch-emails",
              "cancel-email",
              "update-email",
              "create-broadcast",
              "update-broadcast",
              "compose-broadcast",
              "cancel-broadcast",
              "create-contact",
              "update-contact",
              "add-contact-to-segment",
              "update-contact-topics",
              "create-segment",
              "update-segment",
              "create-topic",
              "update-topic",
              "create-template",
              "update-template",
              "compose-template",
              "publish-template"
            ],
            "write": [
              "create-domain",
              "update-domain",
              "verify-domain",
              "create-domain-claim",
              "verify-domain-claim",
              "send-email",
              "send-batch-emails",
              "cancel-email",
              "update-email",
              "create-broadcast",
              "update-broadcast",
              "compose-broadcast",
              "cancel-broadcast",
              "create-contact",
              "update-contact",
              "add-contact-to-segment",
              "update-contact-topics",
              "create-segment",
              "update-segment",
              "create-topic",
              "update-topic",
              "create-template",
              "update-template",
              "compose-template",
              "publish-template"
            ],
            "read": [
              "list-domains",
              "get-domain",
              "get-domain-claim",
              "list-emails",
              "get-email",
              "get-email-metrics",
              "list-received-emails",
              "get-received-email",
              "list-received-email-attachments",
              "get-received-email-attachment",
              "list-broadcasts",
              "get-broadcast",
              "list-broadcast-recipients",
              "list-broadcast-clicked-links",
              "list-contacts",
              "get-contact",
              "list-contact-segments",
              "list-contact-topics",
              "list-segments",
              "get-segment",
              "list-topics",
              "get-topic",
              "list-contact-properties",
              "get-contact-property",
              "list-templates",
              "get-template",
              "list-webhooks",
              "get-webhook",
              "list-webhook-events",
              "get-webhook-event",
              "list-webhook-event-attempts",
              "list-api-keys",
              "list-logs",
              "get-log",
              "get-usage",
              "list-suppressions",
              "get-suppression"
            ]
          }
        }
      }
    }
  },
  "keywords": [
    "resend",
    "email",
    "mail",
    "send-email",
    "transactional-email",
    "newsletter",
    "smtp-alternative",
    "outbound-mail",
    "domains",
    "dns",
    "broadcast",
    "contacts",
    "audience",
    "mcp"
  ]
}
