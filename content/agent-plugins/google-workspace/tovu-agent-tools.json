              "maxProperties": 1,
              "properties": {
                "a1Range": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "A1 range, for example 'Leads'!A1:D50 or Sheet1."
                },
                "gridRange": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sheetId"],
