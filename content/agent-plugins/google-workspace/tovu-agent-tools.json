                      "properties": {
                        "metadataId": { "type": "integer", "minimum": 0 },
                        "metadataKey": { "type": "string", "maxLength": 256 },
                        "metadataValue": { "type": "string", "maxLength": 256 },
                        "locationType": { "enum": ["ROW", "COLUMN", "SHEET", "SPREADSHEET"] },
                        "locationMatchingStrategy": { "enum": ["EXACT_LOCATION", "INTERSECTING_LOCATION"] },
                        "visibility": { "enum": ["DOCUMENT", "PROJECT"] },
                        "metadataLocation": { "type": "object", "maxProperties": 4 }
                      }
                    }
                  }
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10000,
                  "items": {
                    "type": "array",
