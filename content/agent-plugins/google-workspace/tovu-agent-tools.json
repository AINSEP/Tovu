              }
            }
          },
          "valueInputOption": {
            "enum": ["RAW", "USER_ENTERED"],
            "description": "RAW (default) stores text exactly as given; USER_ENTERED parses it like typing into Sheets (formulas included). Use USER_ENTERED only when the person asks for it."
          },
          "valueRenderOption": { "enum": ["FORMATTED_VALUE", "UNFORMATTED_VALUE", "FORMULA"] },
          "dateTimeRenderOption": { "enum": ["SERIAL_NUMBER", "FORMATTED_STRING"] }
        },
        "oneOf": [
          {
            "properties": { "action": { "enum": ["get", "clear"] } },
            "required": ["dataFilters"],
            "not": { "required": ["data"] }
          },
          {
            "properties": { "action": { "const": "update" } },
            "required": ["data"],
            "not": { "required": ["dataFilters"] }
          }
        ]
      }
    },
    {
      "name": "sheets_find",
      "description": "Find cells whose text contains (or, with matchEntireCell, equals) a text in up to 20 explicit ranges. Plain text, no regular expressions. Returns up to 100 cell references with short excerpts (`truncated` when there are more); scanning more than 50,000 cells is refused.",
      "effect": "read",
      "module": "tools/sheets/find.mjs",
      "inputSchema": {
        "type": "object",
        "required": ["connectionRef", "spreadsheetId", "ranges", "text"],
        "additionalProperties": false,
        "properties": {
          "connectionRef": {
            "type": "string",
