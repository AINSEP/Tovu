                    },
                    "startRowIndex": { "type": "integer", "minimum": 0, "maximum": 10000000 },
                    "endRowIndex": { "type": "integer", "minimum": 0, "maximum": 10000000 },
                    "startColumnIndex": { "type": "integer", "minimum": 0, "maximum": 10000000 },
                    "endColumnIndex": { "type": "integer", "minimum": 0, "maximum": 10000000 }
                  }
                },
                "developerMetadataLookup": {
                  "type": "object",
