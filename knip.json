      "project": [
        "apps/website/src/**/*.{ts,tsx,js,mjs}",
        "content/agent-plugins/**/*.{ts,js,mjs,html}",
        "development/scripts/**/*.{ts,js,mjs}",
        "development/eslint-rules/**/*.{ts,js,mjs}",
        "development/e2e/**/*.{ts,tsx,js,mjs}",
        "development/*.ts"
      ],
      "paths": {
        "#src/*": [
          "apps/website/src/*"
        ]
      }
    },
    "apps/admin": {
      "entry": [
        "index.html",
        "src/main.tsx",
        "src/**/*.test.{ts,tsx}",
        "src/__tests__/setup.ts"
      ],
      "project": [
        "**/*.{ts,tsx,js,mjs,html}"
      ]
    },
    "apps/desktop": {
      "entry": [
        "main.ts",
        "src/preload/preload.mts",
        "src/speech/preload-speech.cts",
        "src/renderer/index.html",
        "src/renderer/main.tsx",
        "scripts/*.{ts,mjs}",
        "src/**/*.test.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mts,cts,js,mjs,cjs,html}"
      ]
    },
    "apps/site-chat": {
      "entry": [
        "src/main.tsx",
        "src/loader-entry.ts",
        "src/vanilla-entry.ts",
        "src/**/*.test.ts",
        "scripts/*.mjs"
      ],
      "project": [
        "**/*.{ts,tsx,js,mjs}"
      ],
      "vite": {
        "config": [
          "vite.config.ts",
          "vite.lazy.config.ts",
          "vite.vanilla.config.ts"
        ]
      }
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
