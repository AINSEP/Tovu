{
  "$schema": "https://unpkg.com/knip@5.64.1/schema.json",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/generated/**",
    "**/*.generated.*",
    "**/coverage/**",
    "apps/desktop/release/**",
    "**/test-results/**",
    "ADS-memory/**",
    "AI-Dev-Shop/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "apps/website/src/index.ts",
        "apps/website/src/cli/main.ts",
        "apps/website/src/**/*.test.ts",
        "development/scripts/coverage-changed.ts",
