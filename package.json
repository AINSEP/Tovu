{
  "name": "tovu",
  "version": "0.1.0",
  "private": true,
  "description": "Tovu — the website product: CMS runtime (public site + per-site admin + content model).",
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "bin": {
    "tovu": "dist/src/cli/main.js"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "node development/scripts/dev.mjs",
    "dev:server": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json && node development/scripts/emit-dist-package-json.mjs && mkdir -p dist/src/templates && cp -R src/templates/. dist/src/templates/ && mkdir -p dist/src/themes && cp -R src/themes/. dist/src/themes/ && mkdir -p dist/src/db/drizzle && cp -R src/db/drizzle/. dist/src/db/drizzle/ && mkdir -p dist/src/db/drizzle-database-journal && cp -R src/db/drizzle-database-journal/. dist/src/db/drizzle-database-journal/ && mkdir -p dist/src/public && cp -R src/public/. dist/src/public/",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:e2e",
    "typecheck:e2e": "tsc -p development/tsconfig.e2e.json --noEmit",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:generate:database-journal": "drizzle-kit generate --config=src/db/drizzle.database-journal.config.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\"",
    "test:visual": "playwright test --config=development/playwright.config.ts",
    "test:cov": "rm -rf development/coverage && mkdir -p development/coverage && node --import tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=development/coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout \"src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\"",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "check:architecture": "tsx development/scripts/check-architecture.ts",
    "check:inventory": "tsx development/scripts/check-capability-inventory.ts",
    "check:outbox-bridge": "tsx development/scripts/check-outbox-bridge.ts",
    "lint": "biome lint .",
    "complexity": "eslint --no-error-on-unmatched-pattern .",
    "admin:install": "npm --prefix apps/admin install",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:dev": "npm --prefix apps/admin run dev",
    "setup": "npm install && npm run admin:install && npm run admin:build"
  },
  "dependencies": {
    "@jini-ai/agent-runtime": "file:../Jini/packages/agent-runtime",
    "@jini-ai/agentic": "file:../Jini/packages/agentic",
    "@jini-ai/chat": "file:../Jini/packages/chat",
    "@jini-ai/cms": "file:../Jini/packages/cms",
    "@jini-ai/core": "file:../Jini/packages/core",
    "@jini-ai/daemon": "file:../Jini/packages/daemon",
    "@jini-ai/http-kit": "file:../Jini/packages/http-kit",
    "@jini-ai/mcp": "file:../Jini/packages/mcp",
    "@jini-ai/sqlite": "file:../Jini/packages/sqlite",
    "@jini-ai/ui": "file:../Jini/packages/ui",
    "argon2": "^0.44.0",
    "better-sqlite3": "^11.8.1",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "handlebars": "^4.7.9",
    "liquidjs": "^10.27.1",
    "semver": "^7.6.2",
    "sharp": "^0.35.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/semver": "^7.5.8",
    "dependency-cruiser": "^18.1.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "^10.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0"
  }
}
