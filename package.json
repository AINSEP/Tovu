{
  "name": "tovu",
  "version": "0.1.0",
  "private": true,
  "description": "Tovu — the website product: CMS runtime (public site + per-site admin + content model).",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:generate:storage-journal": "drizzle-kit generate --config=drizzle.storage-journal.config.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:visual": "playwright test",
    "test:cov": "rm -rf coverage && mkdir -p coverage && node --import tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout \"src/**/*.test.ts\"",
    "admin:install": "npm --prefix apps/admin install",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:dev": "npm --prefix apps/admin run dev",
    "setup": "npm install && npm run admin:install && npm run admin:build"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "liquidjs": "^10.27.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.6",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
