{
  "name": "tovu",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Tovu — the website product: CMS runtime (public site + per-site admin + content model).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "tovu": "dist/src/cli/main.js"
  },
  "imports": {
    "#src/*": "./apps/website/src/*.ts"
  },
  "scripts": {
    "prepare": "node development/scripts/prepare-desktop-hooks.mjs",
    "dev": "node development/scripts/dev.mjs",
    "desktop": "node development/scripts/dev-desktop.mjs",
    "seed:site": "node --import tsx development/scripts/seed-site.mjs",
    "dev:server": "tsx watch apps/website/src/index.ts",
    "prestart": "node development/scripts/prepare-start.mjs",
    "start": "node development/scripts/start.mjs",
    "export": "tsx apps/website/src/cli/main.ts export",
    "build": "node development/scripts/check-no-linked-jini.mjs && npm run build:server",
    "build:server": "node development/scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:e2e",
    "typecheck:e2e": "tsc -p development/tsconfig.e2e.json --noEmit",
    "typecheck:scripts": "tsc -p development/tsconfig.scripts.json --noEmit",
    "generate:seed-content": "tsx development/scripts/generate-seed-content.ts",
    "test": "TSX_TSCONFIG_PATH=apps/site-chat/tsconfig.json node --import tsx --test --experimental-test-module-mocks ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"apps/website/src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\" \"apps/site-chat/src/**/*.test.ts\" \"development/scripts/**/*.test.ts\"",
    "test:ci": "mkdir -p development/coverage && rm -f development/coverage/test-results-all.tap && TSX_TSCONFIG_PATH=apps/site-chat/tsconfig.json node --import tsx --test --experimental-test-module-mocks ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --test-reporter=tap --test-reporter-destination=development/coverage/test-results-all.tap --test-reporter=dot --test-reporter-destination=stdout \"apps/website/src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\" \"apps/site-chat/src/**/*.test.ts\" \"development/scripts/**/*.test.ts\"",
    "capture:test-baseline": "tsx development/scripts/check-test-baseline.ts --capture development/scripts/repo-test-failure-baseline.json development/coverage/test-results-all.tap",
    "check:test-baseline": "tsx development/scripts/check-test-baseline.ts development/scripts/repo-test-failure-baseline.json development/coverage/test-results-all.tap",
    "check:idle-motion": "node --import tsx development/scripts/check-idle-motion.ts",
    "test:idle-cpu": "node development/scripts/measure-idle-cpu.mjs",
    "test:visual": "playwright test --config=development/playwright.config.ts",
    "test:visual:regression": "playwright test --config=development/playwright.visual-regression.config.ts",
    "test:e2e:agent-plugin-chip": "playwright test --config=development/playwright.composer-agent-plugin-chip.config.ts",
    "test:e2e:agent-plugin-chip:watch": "TOVU_E2E_SLOWMO=250 playwright test --config=development/playwright.composer-agent-plugin-chip.config.ts --headed",
    "test:e2e:capability-discovery": "playwright test --config=development/playwright.capability-discovery.config.ts",
    "test:e2e:attachment-picker": "playwright test --config=development/playwright.composer-attachment-picker.config.ts",
    "test:cov": "rm -rf development/coverage && mkdir -p development/coverage && TSX_TSCONFIG_PATH=apps/site-chat/tsconfig.json node --import tsx --test --experimental-test-module-mocks ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-coverage-exclude=\"**/__no_route_coverage_gate_exclusions__/**\" --test-reporter=lcov --test-reporter-destination=development/coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout \"apps/website/src/**/*.test.ts\" \"packages/*/src/**/*.test.ts\" \"apps/site-chat/src/**/*.test.ts\"",
    "test:cov:server": "rm -rf development/coverage && mkdir -p development/coverage && node --import tsx --test --experimental-test-module-mocks ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-coverage-exclude=\"**/__no_route_coverage_gate_exclusions__/**\" --test-reporter=lcov --test-reporter-destination=development/coverage/lcov.info --test-reporter=tap --test-reporter-destination=development/coverage/test-results.tap --test-reporter=dot --test-reporter-destination=stdout \"apps/website/src/server/**/*.test.ts\"",
    "test:cov:server:unit": "mkdir -p development/coverage && rm -f development/coverage/lcov.unit.info && node --import tsx --test --experimental-test-module-mocks ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-coverage-exclude=\"**/__no_route_coverage_gate_exclusions__/**\" --test-reporter=lcov --test-reporter-destination=development/coverage/lcov.unit.info --test-reporter=dot --test-reporter-destination=stdout $(npx tsx development/scripts/list-server-test-files.ts unit)",
    "test:cov:server:integration": "mkdir -p development/coverage && rm -f development/coverage/lcov.integration.info && node --import tsx --test --experimental-test-module-mocks ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-coverage-exclude=\"**/__no_route_coverage_gate_exclusions__/**\" --test-reporter=lcov --test-reporter-destination=development/coverage/lcov.integration.info --test-reporter=dot --test-reporter-destination=stdout $(npx tsx development/scripts/list-server-test-files.ts integration)",
    "test:cov:server:tiered": "npm run test:cov:server:unit && npm run test:cov:server:integration",
    "check:boundaries": "depcruise --config .dependency-cruiser.mjs apps/website/src",
    "check:architecture": "tsx development/scripts/check-architecture.ts",
    "check:inventory": "tsx development/scripts/check-capability-inventory.ts",
    "check:outbox-bridge": "tsx development/scripts/check-outbox-bridge.ts",
    "check:seal-aad": "tsx apps/website/src/features/webhooks/seal-aad-invariant.ts",
    "check:secret-scan": "tsx apps/website/src/features/webhooks/secret-scan-guard.ts",
    "check:admin-complexity-drift": "tsx development/scripts/check-admin-complexity-drift.ts",
    "check:src-complexity-drift": "tsx development/scripts/check-src-complexity-drift.ts",
    "check:governance-adr-scope-drift": "tsx development/scripts/check-governance-adr-scope-drift.ts",
    "check:menu-href-allowlist-sync": "tsx development/scripts/check-menu-href-allowlist-sync.ts",
    "check:coverage-integrity": "tsx development/scripts/check-coverage-integrity.ts",
    "check:embed-marker-drift": "tsx development/scripts/check-embed-marker-drift.ts",
    "check:theme-replaced-elements": "tsx development/scripts/check-theme-replaced-elements.ts",
    "check:seed-content-drift": "tsx development/scripts/generate-seed-content.ts --check",
    "check:admin-screens-drift": "cd apps/admin && npx vitest run src/lib/__tests__/admin-screens-manifest.unit.test.ts",
    "check:route-coverage-floor": "tsx development/scripts/check-route-coverage-floor.ts",
    "check:route-coverage-diff": "tsx development/scripts/check-route-coverage-diff.ts",
    "check:route-test-baseline": "tsx development/scripts/check-test-baseline.ts development/scripts/route-test-failure-baseline.json",
    "check:jini-registry-drift": "node development/scripts/check-jini-registry-drift.mjs",
    "check:openapi-contract": "tsx development/scripts/check-openapi-contract.ts",
    "check:openapi-secret-leaks": "tsx development/scripts/check-openapi-secret-leaks.ts",
    "triage:coverage-gaps": "tsx development/scripts/classify-coverage-gaps.ts",
    "triage:churn-hotspots": "tsx development/scripts/report-churn-hotspots.ts",
    "lint": "biome lint .",
    "complexity": "eslint --no-error-on-unmatched-pattern .",
    "admin:install": "npm --prefix apps/admin install",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:dev": "npm --prefix apps/admin run dev",
    "setup": "npm install && npm run admin:install && npm run admin:build",
    "theme": "tsx development/scripts/theme-tool.ts",
    "agent-plugin:package": "tsx development/scripts/package-agent-plugin.ts",
    "agent-plugin:activation": "tsx development/scripts/agent-plugin-activation.ts",
    "ci:local": "bash development/scripts/ci-local.sh",
    "ci:local:tests": "bash development/scripts/ci-local.sh --with-tests",
    "ci:local:route-coverage": "bash development/scripts/ci-local.sh --route-coverage",
    "test:rerun-failing": "bash development/scripts/rerun-failing-tests.sh",
    "link:jini": "node development/scripts/link-jini.mjs",
    "unlink:jini": "node development/scripts/unlink-jini.mjs",
    "check:default-credential": "tsx apps/website/src/features/identity/default-credential-exposure.ts"
  },
  "overrides": {
    "@jini-ai/chat@^0.5.1": {
      "@jini-ai/ui": "$@jini-ai/ui"
    },
    "@jini-ai/http-kit": {
      "@jini-ai/daemon": "$@jini-ai/daemon",
      "@jini-ai/agent-runtime": "$@jini-ai/agent-runtime"
    }
  },
  "dependencies": {
    "@jini-ai/agent-plugins": "^0.4.1",
    "@jini-ai/oauth": "^0.2.0",
    "@ag-ui/core": "0.0.58",
    "@ag-ui/encoder": "0.0.58",
    "@electric-sql/pglite": "0.5.8",
    "@jini-ai/agent-runtime": "^0.4.0",
    "@jini-ai/agentic": "^0.4.1",
    "@jini-ai/analytics": "^0.2.0",
    "@jini-ai/chat": "^0.5.1",
    "@jini-ai/cli": "^0.4.0",
    "@jini-ai/cms": "^0.4.2",
    "@jini-ai/cms-forms": "^0.2.2",
    "@jini-ai/core": "^0.4.0",
    "@jini-ai/daemon": "^0.5.0",
    "@jini-ai/db": "^0.2.0",
    "@jini-ai/desktop-host": "^0.4.1",
    "@jini-ai/devops": "^0.5.1",
    "@jini-ai/diagnostics": "^0.4.0",
    "@jini-ai/http-kit": "^0.4.0",
    "@jini-ai/user-management": "^0.2.0",
    "@jini-ai/integrations": "^0.4.0",
    "@jini-ai/registry": "^0.5.0",
    "@jini-ai/mcp": "^0.4.0",
    "@jini-ai/platform": "^0.5.0",
    "@jini-ai/sandbox": "^0.4.0",
    "@jini-ai/sidecar": "^0.4.0",
    "@jini-ai/ui": "^0.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sindresorhus/slugify": "^3.0.1",
    "argon2": "^0.44.0",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^13.0.0",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "handlebars": "^4.7.9",
    "js-yaml": "^5.3.0",
    "kysely": "^0.29.6",
    "liquidjs": "^10.27.1",
    "nodemailer": "^7.0.13",
    "parse5": "^7.3.0",
    "pg": "^8.23.0",
    "playwright": "^1.61.1",
    "semver": "^7.6.2",
    "sharp": "^0.35.3",
    "yauzl": "^3.4.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.5.8",
    "@types/yauzl": "^3.4.0",
    "astro": "^7.2.1",
    "dependency-cruiser": "^18.1.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "^10.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0",
    "yazl": "^3.3.1"
  }
}
