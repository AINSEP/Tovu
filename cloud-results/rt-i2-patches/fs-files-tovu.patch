--- /dev/null
+++ b/apps/website/src/server/runtime/composition/modules/fs-files.ts
@@ -0,0 +1,96 @@
+import type { Express } from "express";
+
+import {
+  fsCustomRootDeleteRoute, fsCustomRootGetRoute, fsCustomRootPutRoute,
+  type FsCustomRootReadFn, type FsCustomRootWriteFn,
+} from "@jini-ai/cms/admin-http/routes/fs-files/custom-root";
+import { FS_FILES_READ_PERMISSION } from "#src/features/fs-files/agent-tools";
+import { FS_FILES_CUSTOM_ROOT_MANAGE_PERMISSION } from "#src/features/fs-files/custom-root-permission";
+import {
+  CustomFsRootError,
+  getCustomFsRootStatus,
+  setCustomFsRoot,
+  type CustomFsRootStoreOptional,
+} from "#src/features/fs-files/custom-root-store";
+import { mountAdminJsonRoute, type AdminJsonRoutePortDeps } from "#src/server/inbound/admin-http/admin-json-route-ports";
+import type { RouteDeps } from "#src/server/routes/types";
+
+/**
+ * @file Admin chat composer's folder control: `GET`/`PUT`/`DELETE` on
+ * `/api/admin/v1/workspaces/:workspaceId/fs-files/custom-root` — the operator-facing surface for the
+ * `fs-files` domain's `custom` root (`features/fs-files/layout.ts`, `custom-root-store.ts`).
+ *
+ * K1 (RT-K1-adm-fs-files): the three routes are Jini route specs
+ * (`@jini-ai/cms/admin-http/routes/fs-files/custom-root`) mounted behind the admin ports. `RouteDeps`
+ * is read only here, at registration. The root is persisted by `custom-root-store.ts` (a file under
+ * the booted site directory), so the specs never touch the filesystem: this module binds that store,
+ * its site directory, its invalid-path error and the two Tovu permissions as narrow functions and
+ * strings. The sibling `folder-picker` routes stay hand-written (`Cache-Control: no-store` and the
+ * session-credential check read response/request state a JSON spec cannot reach).
+ *
+ * Two permissions, split by verb (owner ruling, 2026-09-15):
+ *
+ * - `GET` — `FS_FILES_READ_PERMISSION` (`content.read`), the SAME permission that gates
+ *   `fs_list_files`/`fs_read_file` themselves. Reading which folder is currently configured tells a
+ *   caller nothing it could not already read through those tools.
+ * - `PUT`/`DELETE` — {@link FS_FILES_CUSTOM_ROOT_MANAGE_PERMISSION}, which only `owner` (via its `*`
+ *   wildcard) and the built-in `admin` role hold. Choosing the folder is not the same capability as
+ *   reading through it: `layout.ts` accepts `/` and a home directory as values, so one `PUT`
+ *   re-points the assistant's whole filesystem surface. See that permission's own file for why it is
+ *   a new string with a built-in-role grant rather than `workspace.manage`, which NO policy in the
+ *   workspace this repo ships actually holds.
+ *
+ * `storeOptional` (2026-09-10, restart-persistence follow-up) is a test-only seam so this route's own
+ * tests can point `custom-root-store.ts` at a temp site directory instead of the real one — see that
+ * field's own doc. Every real caller leaves it unset and gets the real site directory.
+ */
+
+/** The deps the fs-files custom-root registrar reads, a slice of `RouteDeps` plus one test seam. */
+export type AdminFsFilesCustomRootDeps = Pick<RouteDeps, "workspaceId" | "authorize" | "siteBinding"> & {
+  /** Test seam — defaults to the booted `siteBinding.dir`. Set
+   *  only by this route's own tests, to a temp directory, so they never read or write the real site's
+   *  `.fs-custom-root.json`. */
+  readonly storeOptional?: CustomFsRootStoreOptional;
+};
+
+/** Registrar signature for the fs-files custom-root routes (mirrors `RouteRegistrar`). */
+export type AdminFsFilesCustomRootRegistrar = (required: { app: Express; deps: AdminFsFilesCustomRootDeps }, optional?: Record<string, never>) => void;
+
+/** The two port fields every mount passes. `authorize` is read per request, as the hand-written
+ *  routes read `deps.authorize`, so a later reassignment of it is still honoured. */
+function customRootPortDeps({ deps }: { deps: AdminFsFilesCustomRootDeps }, _optional: Record<string, never> = {}): AdminJsonRoutePortDeps {
+  return { workspaceId: deps.workspaceId, authorize: (params) => deps.authorize(params) };
+}
+
+/** The store's persistence root, resolved per call so a late-bound `siteBinding`/`storeOptional` is still honoured. */
+function storeOptionalOf({ deps }: { deps: AdminFsFilesCustomRootDeps }, _optional: Record<string, never> = {}): CustomFsRootStoreOptional {
+  return deps.storeOptional ?? { siteDir: deps.siteBinding.dir };
+}
+
+/** The store's status read, bound to this registration's site directory. */
+function readCustomRootFn({ deps }: { deps: AdminFsFilesCustomRootDeps }, _optional: Record<string, never> = {}): FsCustomRootReadFn {
+  return ({ workspaceId }) => getCustomFsRootStatus({ workspaceId, optional: storeOptionalOf({ deps }) });
+}
+
+/** The store's set-or-clear write, bound to this registration's site directory. */
+function writeCustomRootFn({ deps }: { deps: AdminFsFilesCustomRootDeps }, _optional: Record<string, never> = {}): FsCustomRootWriteFn {
+  return ({ workspaceId, path }) => setCustomFsRoot({ workspaceId, path, optional: storeOptionalOf({ deps }) });
+}
+
+/** The failure copy each verb answered with. `PUT` named its own operation; `GET`/`DELETE` had no
+ *  `try`, so a failure reached the app's error middleware, which answers as `admin-route.uncaught`. */
+function mountOptions(operation: string) {
+  return { authorization: "guarded", failure: { operation, code: "INTERNAL_ERROR" } } as const;
+}
+
+export const registerAdminFsFilesCustomRootRoutes: AdminFsFilesCustomRootRegistrar = ({ app, deps }, _options = {}) => {
+  const ports = customRootPortDeps({ deps });
+  mountAdminJsonRoute({ app, spec: fsCustomRootGetRoute, deps: { ...ports, readPermission: FS_FILES_READ_PERMISSION, readCustomRoot: readCustomRootFn({ deps }) } },
+    mountOptions("admin-route.uncaught"));
+  mountAdminJsonRoute({ app, spec: fsCustomRootPutRoute, deps: {
+    ...ports, managePermission: FS_FILES_CUSTOM_ROOT_MANAGE_PERMISSION, readCustomRoot: readCustomRootFn({ deps }), writeCustomRoot: writeCustomRootFn({ deps }),
+    isInvalidRootError: ({ err }) => err instanceof CustomFsRootError,
+  } }, mountOptions("routes/fs-files/custom-root"));
+  mountAdminJsonRoute({ app, spec: fsCustomRootDeleteRoute, deps: { ...ports, managePermission: FS_FILES_CUSTOM_ROOT_MANAGE_PERMISSION, writeCustomRoot: writeCustomRootFn({ deps }) } },
+    mountOptions("admin-route.uncaught"));
+};
