+import type { MembersConsentCapability } from "../../ports.js";
+
+/**
+ * A granting Members consent binding for tests that exercise double opt-in mail. Production binds
+ * `membersConsentCapability: null` until Members ships one, and confirmation issuance refuses while
+ * it is unbound (B176) — so a test that expects a confirmation token or email has to opt in here,
+ * explicitly, rather than relying on the unbound default.
+ */
+export function boundConsentForTests(_required: Record<string, never> = {}, _optional: Record<string, never> = {}): MembersConsentCapability {
+  return {
+    request: async () => ({ requested: true }),
+    confirm: async () => ({ status: "granted", consentRevisionId: "rev-test" }),
+    revoke: async () => ({ status: "revoked" }),
+  };
+}
