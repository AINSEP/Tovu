{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@tovu/headless": ["../../src/contracts/headless/index.ts"],
      "@tovu/theme-layout": ["../../src/features/theme/theme-layout.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../../src/contracts/headless/**/*.ts", "../../src/features/theme/theme-layout.ts"]
}
