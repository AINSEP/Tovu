{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@tovu/admin-shell": ["../../src/admin-shell/index.ts"],
      "@tovu/headless": ["../../src/headless/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../../src/admin-shell/**/*.ts", "../../src/headless/**/*.ts"]
}
