ll="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-4.5-4.5L7 20"></path></svg>Add cover image</button><span class="post-cover-option"><label><input aria-describedby="ID1" data-agent-element="post-cover-hide-in-body" data-agent-role="checkbox" data-agent-label="Hide the post's first body image on the public page when it is already shown as the cover" type="checkbox" checked="">Hide the cover image in the body</label><span class="info-tip"><span class="info-tip-icon" role="button" tabindex="0" aria-label="Applies when the cover comes from the first image in the post" aria-expanded="false" data-agent-element="post-cover-hide-in-body-info" data-agent-role="button" data-agent-label="Applies when the cover comes from the first image in the post">ⓘ</span><span id="ID1" hidden="">Applies when the cover comes from the first image in the post</span></span></span></div><div class="editor-body" data-agent-element="post-body" data-agent-role="field" data-agent-label="The post's rich-text body content"><div><div contenteditable="true" role="textbox" aria-label="Content" translate="no" class="tiptap ProseMirror" tabindex="0"><h1 data-post-title="">Hello world</h1><p>Body text here</p></div><div style="pointer-events: none; position: absolute; top: 0px; left: 0px; z-index: 10;"><div class="drag-handle" style="visibility: hidden; position: absolute; pointer-events: auto;" data-dragging="false" draggable="true"><div class="editor-drag-handle" title="Drag to reorder" aria-hidden="true"><svg viewBox="0 0 18 18" fill="currentColor"><circle cx="6" cy="4" r="1.3"></circle><circle cx="12" cy="4" r="1.3"></circle><circle cx="6" cy="9" r="1.3"></circle><circle cx="12" cy="9" r="1.3"></circle><circle cx="6" cy="14" r="1.3"></circle><circle cx="12" cy="14" r="1.3"></circle></svg></div></div></div></div></