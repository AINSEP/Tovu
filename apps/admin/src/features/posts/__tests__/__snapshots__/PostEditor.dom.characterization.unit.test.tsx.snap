/p></div><div class="confirm-dialog-actions"><button type="button" class="btn-secondary" data-agent-element="post-delete-confirm-cancel" data-agent-role="button" data-agent-label="Cancel — leaves &quot;Discard post?&quot; unconfirmed; no action taken" data-jini-part="confirm.cancel" aria-busy="false" data-jini-state="ready">Cancel</button><button type="button" class="btn-danger" data-agent-element="post-delete-confirm-confirm" data-agent-role="button" data-agent-label="Discard — Discard post?; cannot be undone" data-jini-part="confirm.confirm" aria-busy="false" data-jini-state="ready">Discard</button></div></dialog></div>"`;

