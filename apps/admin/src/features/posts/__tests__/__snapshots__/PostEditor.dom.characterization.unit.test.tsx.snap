exports[`PostEditor DOM — preview tab > expanded preview wraps the same pane in the expanded panel and keeps one fab 1`] = `"<div class="page content-editor-page"><div class="content-editor-header" data-agent-element="post-header" data-agent-role="region" data-agent-label="Editor header — the back link, the title and the URL slug. Save, Delete and the Draft/Published field are NOT here: they are in the action row below the view toolbar."><h1 class="visually-hidden">Edit post</h1><a class="content-editor-back" href="/admin/posts" aria-label="Back: Posts" data-agent-element="post-back-to-list" data-agent-role="link" data-agent-label="Back to the list of all posts"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg></a><label class="a11y-label-wrap content-editor-title-wrap"><span class="visually-hidden">Post title</span><textarea class="editor-title content-editor-title" rows="1" placeholder="Post title" data-agent-element="post-title" data-agent-role="field" data-agent-label="This post's title">Hello world</textarea></label><div class="editor-slug">/ <label class="a11y-label-wrap"><span class="visually-hidden">URL slug</span><input data-agent-element="post-slug" data-agent-role="field" data-agent-label="URL slug this post is published at" value="hello-world"></label><a href="/hello-world" target="_blank" rel="noreferrer" data-agent-element="post-view-live" data-agent-role="link" data-agent-label="Open this post on the public site in a new tab">view ↗</a></div></div><div class="page-editor-toolbar"><div class="content-editor-toolbar-start"><div class="segmented" role="tablist" aria-label="Editor view"><button type="button" role="tab" aria-selected="false" tabindex="-1" data-agent-element="post-view-edit" data-agent-role="button" data-agent-label="Switch to the rich-text editor for this post">Editor</button><button type="button" role="tab" aria-selected="true" class="is-active" tabindex="0" data-agent-element="post-view-preview" data-agent-role="button" data-agent-label="Switch to a rendered preview of how this post looks on the site">Preview</button></div><div class="segmented" role="group" aria-label="Preview width"><button type="button" aria-pressed="true" aria-label="Desktop" title="Desktop" class="is-active" data-agent-element="post-preview-width-desktop" data-agent-role="button" data-agent-label="Preview at Desktop width"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="12" rx="1.5"></rect><path d="M2 19h20"></path></svg></button><button type="button" aria-pressed="false" aria-label="Tablet" title="Tablet" data-agent-element="post-preview-width-tablet" data-agent-role="button" data-agent-label="Preview at Tablet width"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M11 18h2"></path></svg></button><button type="button" aria-pressed="false" aria-label="Mobile" title="Mobile" data-agent-element="post-preview-width-mobile" data-agent-role="button" data-agent-label="Preview at Mobile width"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="7" y="2" width="10" height="20" rx="2"></rect><path d="M11 18h2"></path></svg></button><span class="page-editor-width">1280px</span></div></div><div class="page-editor-toolbar-end"><button type="button" class="theme-explore-fullscreen-trigger" aria-label="Reload preview" title="Reload preview"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg></button><div class="editor-template-picker"><select disabled="" aria-label="Template" data-agent-element="post-template-choice" data-agent-role="field" data-agent-label="The active theme declares no post templates, so there is nothing to choose here."><option value="">No templates for this theme</option></select></div></div></div><div class="editor-action-row content-action-row" data-agent-element="post-actions" data-agent-role="region" data-agent-label="Save status, the Draft/Published field, and the Publish, Save and Delete buttons"><div class="content-action-group"><select aria-label="Status" data-agent-element="post-status" data-agent-role="field" data-agent-label="Whether this post is a draft or published — set with page.select_option, not click. Setting to Draft unpublishes it (content is kept, just hidden from the site); this is NOT the same as Delete, which moves the whole entry to the trash."><option value="draft">Draft</option><option value="published">Published</option></select><button type="button" data-agent-element="post-publish" data-agent-role="button" data-agent-label="Publish this post/page immediately — saves the current title, slug and body and sets status to Published in one action. Only shown while the post is a draft; once published, use Save for further edits.">Publish</button><button type="button" class="btn-secondary" data-agent-element="post-save" data-agent-role="button" data-agent-label="Save this post's title, slug, status and body">Save</button><button type="button" class="btn-danger" data-agent-element="post-delete" data-agent-role="button" data-agent-label="Move this post/page to the trash — different from unpublishing (the Draft/Published field beside it): the entry disappears from every list and the site. Asks for confirmation before deleting.">Delete</button></div><button type="button" class="view-template-btn post-settings-trigger" aria-label="Post settings" title="Post settings" data-agent-element="post-settings-open" data-agent-role="button" data-agent-label="Open the post settings: author and show-author, publish time, and featured image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 0 1-2.82 2.83l-.06-.07a1.7 1.7 0 0 0-1.88-.33 1.7 1.7 0 0 0-1.04 1.56V21a2 2 0 0 1-4 0v-.1A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.82l.07-.06a1.7 1.7 0 0 0 .33-1.88 1.7 1.7 0 0 0-1.56-1.04H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.56-1.04 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.07A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1.04-1.56V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1.04 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.07.06a1.7 1.7 0 0 0-.33 1.87V9a1.7 1.7 0 0 0 1.56 1.04H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.56 1.04Z"></path></svg></button></div><div class="post-preview-expanded"><div class="post-preview-surface"><div class="editor-shell post-editor-pane"><p class="field-hint editor-preview-note">Cookie banner hidden in preview. Embedded videos may not play here; open the page to check.</p><div class="page-preview-frame"><div class="page-preview-scaler" style="width: 1280px; height: calc(145.455%); transform: scale(0.6875);"><form method="post" target="post-preview-pending-p1" action="fake://template-preview/p1?templateChoice=&amp;__tovu_preview=UUID" hidden=""><input type="hidden" value="{&quot;type&quot;:&quot;doc&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;title&quot;,&quot;attrs&quot;:{&quot;textAlign&quot;:null},&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Hello world&quot;}]},{&quot;type&quot;:&quot;paragraph&quot;,&quot;attrs&quot;:{&quot;textAlign&quot;:null},&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Body text here&quot;}]}]}" name="bodyJson"></form><iframe name="post-preview-pending-p1" title="Post preview" class="page-preview-iframe" sandbox="allow-scripts allow-forms allow-popups" referrerpolicy="no-referrer"></iframe></div></div></div><button type="button" class="post-preview-fab" title="Exit full screen (Esc)" aria-label="Exit full screen" data-agent-element="post-preview-expand" data-agent-role="button" data-agent-label="Exit full screen: exit fullscreen to collapse or close the expanded preview, putting it back to its normal, smaller size. Already maximized, so if the ask was to show it big, it already is."><span aria-hidden="true">⤡</span></button></div></div><div data-testid="content-analysis">p1</div><div data-testid="term-picker">post/p1</div><dialog class="confirm-dialog" aria-labelledby="ID1"><h2 id="ID1">Nothing changed</h2><div class="confirm-dialog-body"><p>Nothing has changed since the last save. Save anyway?</p></div><div class="confirm-dialog-actions"><button type="button" class="btn-secondary" data-agent-element="post-save-unchanged-confirm-cancel" data-agent-role="button" data-agent-label="Cancel — leaves &quot;Nothing changed&quot; unconfirmed; no action taken" data-jini-part="confirm.cancel" aria-busy="false" data-jini-state="ready">Cancel</button><button type="button" data-agent-element="post-save-unchanged-confirm-confirm" data-agent-role="button" data-agent-label="Save anyway — Nothing changed" data-jini-part="confirm.confirm" aria-busy="false" data-jini-state="ready">Save anyway</button></div></dialog><dialog class="confirm-dialog" aria-labelledby="ID2"><h2 id="ID2">Move to trash?</h2><div class="confirm-dialog-body"><p>Move this post ("Hello world") to trash? It will disappear from the site and from the posts list.</p></div><div class="confirm-dialog-actions"><button type="button" class="btn-secondary" data-agent-element="post-delete-confirm-cancel" data-agent-role="button" data-agent-label="Cancel — leaves &quot;Move to trash?&quot; unconfirmed; no action taken" data-jini-part="confirm.cancel" aria-busy="false" data-jini-state="ready">Cancel</button><button type="button" class="btn-danger" data-agent-element="post-delete-confirm-confirm" data-agent-role="button" data-agent-label="Move to trash — Move to trash?; cannot be undone" data-jini-part="confirm.confirm" aria-busy="false" data-jini-state="ready">Move to trash</button></div></dialog></div>"`;

