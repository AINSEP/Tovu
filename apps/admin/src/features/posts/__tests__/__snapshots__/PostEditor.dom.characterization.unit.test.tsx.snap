on><button type="button" class="btn-danger" data-agent-element="post-delete-confirm-confirm" data-agent-role="button" data-agent-label="Move to trash — Move to trash?; cannot be undone" data-jini-part="confirm.confirm" aria-busy="false" data-jini-state="ready">Move to trash</button></div></dialog></div>"`;

