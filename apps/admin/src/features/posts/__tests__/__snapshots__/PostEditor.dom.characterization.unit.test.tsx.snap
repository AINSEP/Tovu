s="grp"><span class="tb-select-group"><span class="tb-select-label" aria-hidden="true">Font</span><select class="tb-select" title="Font family" aria-label="Font family"><option value="">DM Sans (Default)</option><option value="ui-sans-serif, system-ui, sans-serif">Sans-serif</option><option value="ui-serif, Georgia, serif">Serif</option><option value="ui-monospace, 'SF Mono', monospace">Monospace</option><option value="Georgia, serif">Georgia</option><option value="Arial, sans-serif">Arial</option><option value="'Courier New', monospace">Courier New</option></select></span><span class="tb-select-group"><span class="tb-select-label" aria-hidden="true">Size</span><select class="tb-select" title="Font size" aria-label="Font size"><option value="">16 (Default)</option><option value="12px">12</option><option value="14px">14</option><option value="16px">16</option><option value="18px">18</option><option value="20px">20</option><option value="24px">24</option><option value="32px">32</option><option value="48px">48</option></select></span><span class="tb-select-group"><span class="tb-select-label" aria-hidden="true">Line</span><select class="tb-select" title="Line height" aria-label="Line height"><option value="">1.6 (Default)</option><option value="1">1</option><option value="1.15">1.15</option><option value="1.5">1.5</option><option value="1.75">1.75</option><option value="2">2</option></select></span></div><div class="grp"><span class="embed-insert-control"><button type="button" class="tb-btn" title="Insert media, a form, a menu, or a widget" aria-haspopup="menu" aria-expanded="false">Embed</button></span><button class="tb-btn" title="Insert image by URL">Img by URL</button><button class="tb-btn" title="Insert YouTube video">YouTube</button><select class="tb-select" title="Mention a post" aria-label="Mention a post"><option value="">Mention…</option></select></div><button class="tb-btn tb-more" title="More formatting" aria-label="More formatting" aria-expanded="false"><svg viewBox="0 0 18 18" fill="currentColor" aria-hidden="true"><circle cx="4" cy="9" r="1.4"></circle><circle cx="9" cy="9" r="1.4"></circle><circle cx="14" cy="9" r="1.4"></circle></svg></button><span class="editor-toolbar-count" aria-live="polite">25 characters</span>"`;

