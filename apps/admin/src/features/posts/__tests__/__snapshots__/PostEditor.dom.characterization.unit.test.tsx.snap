exports[`PostEditor DOM — states > outside-change banner suppresses the stale-basis banner 1`] = `"<div class="page content-editor-page"><div class="content-editor-header" data-agent-element="post-header" data-agent-role="region" data-agent-label="Editor header — the back link, the title and the URL slug. Save, Delete and the Draft/Published field are NOT here: they are in the action row below the view toolbar."><h1 class="visually-hidden">Edit post</h1><a class="content-editor-back" href="/admin/posts" aria-label="Back: Posts" data-agent-element="post-back-to-list" data-agent-role="link" data-agent-label="Back to the list of all posts"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg></a><label class="a11y-label-wrap content-editor-title-wrap"><span class="visually-hidden">Post title</span><textarea class="editor-title content-editor-title" rows="1" placeholder="Post title" data-agent-element="post-title" data-agent-role="field" data-agent-label="This post's title">Hello world</textarea></label><div class="editor-slug">/ <label class="a11y-label-wrap"><span class="visually-hidden">URL slug</span><input data-agent-element="post-slug" data-agent-role="field" data-agent-label="URL slug this post is published at" value="hello-world"></label><a href="/hello-world" target="_blank" rel="noreferrer" data-agent-element="post-view-live" data-agent-role="link" data-agent-label="Open this post on the public site in a new tab">view ↗</a></div></div><div class="notice warning" data-agent-element="page-external-change" data-agent-role="region" data-agent-label="This page was changed outside the editor, probably by the assistant — load the latest version or keep your unsaved edits"><p>Changed outside the editor, probably by the assistant. Loading the latest version discards your unsaved edits.</p><button type="button" class="btn-secondary" data-agent-element="page-external-change-load-latest" data-agent-role="button" data-agent-label="Load latest version, discarding my unsaved edits">Load latest</button><button type="button" class="btn-secondary" data-agent-element="page-external-change-keep-edits" data-agent-role="button" data-agent-label="Keep my edits and ignore the outside change">Keep my edits</button></div><div class="page-editor-toolbar"><div class="content-editor-toolbar-start"><div class="segmented" role="tablist" aria-label="Editor view"><button type="button" role="tab" aria-selected="true" class="is-active" tabindex="0" data-agent-element="post-view-edit" data-agent-role="button" data-agent-label="Switch to the rich-text editor for this post">Editor</button><button type="button" role="tab" aria-selected="false" tabindex="-1" data-agent-element="post-view-preview" data-agent-role="button" data-agent-label="Switch to a rendered preview of how this post looks on the site">Preview</button></div></div><div class="page-editor-toolbar-end"><div class="editor-template-picker"><select disabled="" aria-label="Template" data-agent-element="post-template-choice" data-agent-role="field" data-agent-label="The active theme declares no post templates, so there is nothing to choose here."><option value="">No templates for this theme</option></select></div></div></div><div class="editor-action-row content-action-row" data-agent-element="post-actions" data-agent-role="region" data-agent-label="Save status, the Draft/Published field, and the Publish, Save and Delete buttons"><div class="content-action-group"><select aria-label="Status" data-agent-element="post-status" data-agent-role="field" data-agent-label="Whether this post is a draft or published — set with page.select_option, not click. Setting to Draft unpublishes it (content is kept, just hidden from the site); this is NOT the same as Delete, which moves the whole entry to the trash."><option value="draft">Draft</option><option value="published">Published</option></select><button type="button" data-agent-element="post-publish" data-agent-role="button" data-agent-label="Publish this post/page immediately — saves the current title, slug and body and sets status to Published in one action. Only shown while the post is a draft; once published, use Save for further edits.">Publish</button><button type="button" class="btn-secondary" data-agent-element="post-save" data-agent-role="button" data-agent-label="Save this post's title, slug, status and body">Save</button><button type="button" class="btn-danger" data-agent-element="post-delete" data-agent-role="button" data-agent-label="Move this post/page to the trash — different from unpublishing (the Draft/Published field beside it): the entry disappears from every list and the site. Asks for confirmation before deleting.">Delete</button></div><button type="button" class="view-template-btn post-settings-trigger" aria-label="Post settings" title="Post settings" data-agent-element="post-settings-open" data-agent-role="button" data-agent-label="Open the post settings: author and show-author, publish time, and featured image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 0 1-2.82 2.83l-.06-.07a1.7 1.7 0 0 0-1.88-.33 1.7 1.7 0 0 0-1.04 1.56V21a2 2 0 0 1-4 0v-.1A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.82l.07-.06a1.7 1.7 0 0 0 .33-1.88 1.7 1.7 0 0 0-1.56-1.04H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.56-1.04 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.07A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1.04-1.56V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1.04 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.07.06a1.7 1.7 0 0 0-.33 1.87V9a1.7 1.7 0 0 0 1.56 1.04H21a2 2 0 0 1 0 4h-.1