exports[`PostEditor DOM — states > loaded published post (no Publish button, Save is primary) 1`] = `"<div class="page content-editor-page"><div class="content-editor-header" data-agent-element="post-header" data-agent-role="region" data-agent-label="Editor header — the back link, the title and the URL slug. Save, Delete and the Draft/Published field are NOT here: they are in the action row below the view toolbar."><h1 class="visually-hidden">Edit post</h1><a class="content-editor-back" href="/admin/posts" aria-label="Back: Posts" data-agent-element="post-back-to-list" data-agent-role="link" data-agent-label="Back to the list of all posts"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg></a><label class="a11y-label-wrap content-editor-title-wrap"><span class="visually-hidden">Post title</span><textarea class="editor-title content-editor-title" rows="1" placeholder="Post title" data-agent-element="post-title" data-agent-role="field" data-agent-label="This post's title">Hello world</textarea></label><div class="editor-slug">/ <label class="a11y-label-wrap"><span class="visually-hidden">URL slug</span><input data-agent-element="post-slug" data-agent-role="field" data-agent-label="URL slug this post is published at" value="hello-world"></label><a href="/hello-world" target="_blank" rel="noreferrer" data-agent-element="post-view-live" data-agent-role="link" data-agent-label="Open this post on the public site in a new tab">view ↗</a></div></div><div class="page-editor-toolbar"><div class="content-editor-toolbar-start"><div class="segmented" role="tablist" aria-label="Editor view"><button type="button" role="tab" aria-selected="true" class="is-active" tabindex="0" data-agent-element="post-view-edit" data-agent-role="button" data-agent-label="Switch to the rich-text editor for