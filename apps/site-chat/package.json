{
  "name": "tovu-site-chat",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "node ../../development/scripts/check-no-linked-jini.mjs && vite build",
    "build:local": "vite build && node scripts/check-bundle-mounts.mjs",
    "postbuild": "node scripts/check-bundle-mounts.mjs",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@jini-ai/agentic": "^0.4.0",
    "@jini-ai/chat": "^0.5.0",
    "@jini-ai/protocol": "^0.4.0",
    "@jini-ai/ui": "^0.4.1",
    "@mcp-ui/client": "7.1.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.2",
    "vite": "^7.2.4"
  },
  "overrides": {
    "@jini-ai/ui": "$@jini-ai/ui"
  }
}
