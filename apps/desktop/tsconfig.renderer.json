{
  // Typecheck-only pass over the renderer (Vite does the actual transform). Mirrors Tovu-Runner's
  // own `tsconfig.renderer.json` — the DOM libs, `react-jsx`, and `bundler` resolution that
  // `tsconfig.preload.json` deliberately does not have.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/contracts/**/*.ts", "vite.config.mts"],
  // These eight source-text wiring tests were renamed from .test.js in TypeScript migration Phase 3 with zero
  // annotations. As JavaScript they were never typechecked, and strict mode rejects their untyped helper
  // parameters. Phase 4 types them. See ADS-memory/reports/2026-09-12-desktop-typescript-migration-plan.md.
  "exclude": [
    "src/renderer/card-preview-wiring.test.ts",
    "src/renderer/marketplace-nav-wiring.test.ts",
    "src/renderer/one-chat-fab-wiring.test.ts",
    "src/renderer/rescan-wiring.test.ts",
    "src/renderer/site-card-menu-wiring.test.ts",
    "src/renderer/tasks-nav-hidden-wiring.test.ts",
    "src/renderer/webview-failure-wiring.test.ts",
    "src/renderer/webview-partition-wiring.test.ts"
  ]
}
