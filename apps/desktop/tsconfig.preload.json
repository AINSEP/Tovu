{
  // Compiles ONLY the preload and the shared contracts it imports — never `main.ts` or anything
  // else under `src/`. This shell's main process is TypeScript (`main.ts`, `src/*.ts`,
  // `src/speech/*.ts` — ESM, per this package's `"type": "module"`, with no compile step: Electron
  // and Node strip the types at load time) and is typechecked separately, under
  // `tsconfig.main.json`'s strict ratchet; Tovu-Runner's equivalent `tsconfig.json` additionally
  // compiled `src/main/**`, which has no counterpart here until phase 2 of the port.
  //
  // `preload.mts` -> `dist/preload/preload.mjs`: Electron 43 supports a native-ESM preload only in
  // an unsandboxed, context-isolated renderer, which is exactly how `main.ts` creates the sites home
  // window (and only that window — site-admin windows keep `sandbox: true` and the `.cjs` speech
  // preload).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src/preload/**/*.mts", "src/contracts/**/*.ts"]
}
