{
  "name": "tovu-desktop",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "description": "Electron shell around the same Tovu the web mode serves. Additive: nothing outside this directory knows it exists.",
  "main": "main.ts",
  "scripts": {
    "dev": "electron .",
    "attach": "electron .",
    "build": "npm run build:preload && npm run build:renderer",
    "build:preload": "rm -rf dist/preload dist/contracts dist/speech && tsc -p tsconfig.preload.json && esbuild src/speech/preload-speech.cts --bundle --platform=node --format=cjs --external:electron --outfile=dist/speech/preload-speech.cjs",
    "build:renderer": "vite build",
    "watch:renderer": "vite build --watch",
    "typecheck": "tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json && tsc -p tsconfig.main.json && tsc -p tsconfig.live-verify.json",
    "pretest": "npm run build:preload",
    "test": "node --experimental-test-module-mocks --test \"src/*.test.ts\" \"src/!(renderer|contracts)/**/*.test.ts\" && node --import tsx --test \"src/renderer/**/*.test.ts\" \"src/contracts/**/*.test.ts\"",
    "gates": "node scripts/check-gates.ts",
    "stage": "node scripts/stage-payload.ts",
    "package": "npm run gates && npm run build && npm run stage && electron-builder --mac && node scripts/verify-package.ts"
  },
  "dependencies": {
    "@jini-ai/agent-runtime": "^0.4.4",
    "@jini-ai/chat": "^0.5.7",
    "@jini-ai/core": "^0.4.1",
    "@jini-ai/daemon": "^0.6.0",
    "@jini-ai/desktop-host": "^0.4.1",
    "@jini-ai/mcp": "^0.4.1",
    "@jini-ai/platform": "^0.5.1",
    "@mcp-ui/client": "7.1.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "recharts": "^3.10.1",
    "eventsource": "^3.0.7"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@jini-ai/agentic": "^0.4.2",
    "@jini-ai/protocol": "^0.4.3",
    "@jini-ai/ui": "^0.4.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "micromark": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "npm": "11.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^1.24.4",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  },
  "overrides": {
    "@jini-ai/core": "^0.4.1"
  }
}
