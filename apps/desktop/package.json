{
  "name": "tovu-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron shell around the same Tovu the web mode serves. Additive: nothing outside this directory knows it exists.",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "attach": "electron .",
    "build": "npm run build:preload && npm run build:renderer",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json",
    "test": "node --test \"src/**/*.test.cjs\" && node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@jini-ai/chat": "^0.3.4"
  },
  "devDependencies": {
    "@jini-ai/protocol": "^0.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
