# Lazily-compiled speech helper binary (`src/speech/mac-on-device-transcriber.cjs`'s
# `ensureHelperCompiled`) — built on first use from the committed `.swift` source, never itself
# committed. Same posture as any other local build output.
src/speech/.build/

# electron-builder inputs and outputs. `staging/tovu-payload/` is the 427MB runnable Tovu tree
# `scripts/stage-payload.mjs` assembles from the repo's own build output; `release/` is the packaged
# `.app`/`.dmg`. Both are regenerable build artifacts, never sources.
staging/
release/

# Verification bundles from a diagnostic pack into a separate output dir
# (electron-builder --mac dir --config.directories.output=release-probe2). Same posture as
# release/: regenerable build output, never a source. Kept on disk rather than deleted because
# a pack built against a QUIET tree is the only way to tell a clean archive from a corrupt one
# -- see ADS-memory/reports/2026-09-12-packaging-asar-corruption.md.
release-probe*/

# Another such verification pack output dir -- `release-probe*/` above does not match this name.
# Same posture: regenerable, never a source.
release-verify/

# `node --experimental-test-coverage`'s lcov output (`npm run gates`'s coverage gate). Regenerable
# build output, never a source -- same posture as apps/admin/coverage/ and /coverage/ in the repo
# root .gitignore.
coverage/
