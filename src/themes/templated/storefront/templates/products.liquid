{%- comment -%}
  Storefront — products (full grid). Same card markup as home's featured
  section but every product, not a teaser.
{%- endcomment -%}
{% render_block component: "tovu/site-header", compact: true %}

<main class="wrap">
  <div class="page-header">
    <h1>All products</h1>
  </div>

  {%- if products.size == 0 -%}
    <p class="products__empty">No products available — the store plugin isn't enabled in this runtime.</p>
  {%- else -%}
    <ul class="product-grid">
      {%- for product in products -%}
        <li class="product-card">
          <a href="/products/{{ product.id }}">
            <div class="product-card__image" aria-hidden="true"></div>
            <h3 class="product-card__title">{{ product.title }}</h3>
            <p class="product-card__price">{{ product.priceFormatted }}</p>
            {%- if product.stock == 0 -%}
              <p class="product-card__stock product-card__stock--out">Sold out</p>
            {%- else -%}
              <p class="product-card__stock">{{ product.stock }} in stock</p>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</main>

{% render_block component: "tovu/site-footer" %}
